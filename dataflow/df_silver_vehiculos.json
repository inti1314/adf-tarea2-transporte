{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = ERROR_FUNCTION(''),",
				"          Placa = ERROR_FUNCTION(''),",
				"          TipoVehiculo = ERROR_FUNCTION(''),",
				"          CapacidadEfectiva = ERROR_FUNCTION(''),",
				"          VigenciaDesde = ERROR_FUNCTION(''),",
				"          VigenciaHasta = ERROR_FUNCTION('')) ~> derivedColumn1",
				"derivedColumn1 derive() ~> derivedColumn2"
			]
		}
	}
}